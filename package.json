{
  "name": "sprite-sheet-studio",
  "private": true,
  "version": "0.4.0-dev.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runtime && tsc && vite build",
    "build:runtime": "node scripts/build-runtime-bundle.mjs && node --check src/runtime.bundle.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build:runtime && npm run typecheck && npm run lint && npm run format:check",
    "test:install": "playwright install chromium",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.5"
  }
}
